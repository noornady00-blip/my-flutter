rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@mahameek\\.admin\\.com$')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'subadmin'))
      );
    }

    // ==================== USERS COLLECTION ====================
    match /users/{uid} {
      // User can read their own profile, or an authenticated admin can read any profile
      allow read: if isOwner(uid) || isAdmin();

      // Users can create their own document (cannot self-assign admin role)
      allow create: if (isOwner(uid) && (!('role' in request.resource.data) || request.resource.data.role != 'admin')) || isAdmin();

      // Users can update their own data, or admin can update
      allow update: if isOwner(uid) || isAdmin();

      // Only admins or the owner can delete the account document
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ==================== LAWYERS COLLECTION ====================
    match /lawyers/{uid} {
      // Anyone can read approved lawyers, or owner/admin can read any
      allow read: if (resource != null && resource.data.status == 'approved') || isOwner(uid) || isAdmin();

      // Lawyer can register with initial status 'pending', or admin can create
      allow create: if (isOwner(uid) && (!('status' in request.resource.data) || request.resource.data.status == 'pending')) || isAdmin();

      // Lawyer can update their profile information, or admin can update
      allow update: if isOwner(uid) || isAdmin();

      // Lawyer can delete their own document or admins can delete
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ==================== ACCOUNT IDS COLLECTION ====================
    match /account_ids/{accountId} {
      // Public lookup and registration for 12-digit account numbers
      allow read, write: if true;
    }

    // ==================== CHATS & DIRECT MESSAGING ====================
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() || isAdmin();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated() || isAdmin();
      }
    }

    // ==================== ADMINS COLLECTION ====================
    match /admins/{docId} {
      allow read: if isOwner(docId) || isAdmin();
      allow write: if isAdmin();
    }

    match /admin_tokens/{tokenId} {
      allow read, write: if isAuthenticated() || isAdmin();
    }

    match /admin_fcm_tokens/{adminUid} {
      allow read, write: if isAuthenticated() || isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isAuthenticated();
      allow update, delete: if false;
    }

    match /rate_limits/{docId} {
      allow read, write: if true;
    }

    match /one_time_resets/{docId} {
      allow read, write: if isAdmin();
    }

    // ==================== SUPPORT MESSAGES COLLECTION ====================
    match /support_messages/{msgId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ==================== PASSWORD RESETS COLLECTION ====================
    match /password_resets/{resetId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ==================== PHONE DIRECTORY COLLECTION ====================
    match /phone_directory/{phoneKey} {
      // Fast public lookup and registration for single canonical +249... phone numbers
      allow read, write: if true;
    }

    // ==================== ADMIN NOTIFICATIONS COLLECTION ====================
    match /admin_notifications/{notifId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ==================== APP CONFIG COLLECTION ====================
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== LAWYER REQUESTS COLLECTION ====================
    match /lawyer_requests/{uid} {
      allow create: if isOwner(uid) || isAdmin();
      allow read, update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }
  }
}
