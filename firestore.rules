rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // 🔐 HELPER FUNCTIONS
    // ============================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@mahameek\\.admin\\.com$')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'subadmin'))
      );
    }

    // ============================================================================
    // 👥 USERS COLLECTION
    // ============================================================================
    match /users/{uid} {
      // User can read their own profile, or an authenticated admin can read any profile
      allow read: if isOwner(uid) || isAdmin();

      // Users can create their own document (cannot self-assign admin role)
      allow create: if (isOwner(uid) && (!('role' in request.resource.data) || request.resource.data.role != 'admin')) || isAdmin();

      // Users can update their own data, but CANNOT self-escalate role, primary status, or accountId
      allow update: if (isOwner(uid) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPrimary', 'accountId']))) || isAdmin();

      // Only admins or the owner can delete the account document
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ============================================================================
    // ⚖️ LAWYERS COLLECTION
    // ============================================================================
    match /lawyers/{uid} {
      // Anyone can read approved lawyers, or owner/admin can read any
      allow read: if (resource != null && resource.data.status == 'approved') || isOwner(uid) || isAdmin();

      // Lawyer can register with initial status 'pending', or admin can create
      allow create: if (isOwner(uid) && (!('status' in request.resource.data) || request.resource.data.status == 'pending')) || isAdmin();

      // Lawyer can update profile information, but CANNOT self-approve or self-assign role or accountId
      allow update: if (isOwner(uid) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'role', 'approvedAt', 'accountId']))) || isAdmin();

      // Lawyer can delete their own document or admins can delete
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ============================================================================
    // 🔢 ACCOUNT IDS COLLECTION (12-Digit Unique Numbers)
    // ============================================================================
    match /account_ids/{accountId} {
      // Public lookup for account verification
      allow read: if true;

      // Only authenticated users registering their own accountId or admins can write
      allow create, update: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ============================================================================
    // 💬 CHATS & DIRECT MESSAGING (Strict Participant Isolation)
    // ============================================================================
    match /chats/{chatId} {
      // Allow read/write ONLY if user is a participant or an admin
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && request.auth.uid in resource.data.participants) ||
        chatId.matches('^chat_.*' + request.auth.uid + '.*$')
      );

      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid in request.resource.data.participants ||
        chatId.matches('^chat_.*' + request.auth.uid + '.*$')
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && request.auth.uid in resource.data.participants) ||
        chatId.matches('^chat_.*' + request.auth.uid + '.*$')
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && request.auth.uid in resource.data.participants) ||
        chatId.matches('^chat_.*' + request.auth.uid + '.*$')
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          isAdmin() ||
          chatId.matches('^chat_.*' + request.auth.uid + '.*$') ||
          (exists(/databases/$(database)/documents/chats/$(chatId)) &&
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants)
        );

        allow create: if isAuthenticated() && (
          isAdmin() ||
          chatId.matches('^chat_.*' + request.auth.uid + '.*$') ||
          request.resource.data.senderId == request.auth.uid
        );

        allow update, delete: if isAuthenticated() && (
          isAdmin() ||
          chatId.matches('^chat_.*' + request.auth.uid + '.*$') ||
          (resource != null && resource.data.senderId == request.auth.uid) ||
          (exists(/databases/$(database)/documents/chats/$(chatId)) &&
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants)
        );
      }
    }

    // ============================================================================
    // 🛡️ ADMINS & SYSTEM MANAGEMENT
    // ============================================================================
    match /admins/{docId} {
      allow read: if isOwner(docId) || isAdmin();
      allow write: if isAdmin();
    }

    match /admin_tokens/{tokenId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    match /admin_fcm_tokens/{adminUid} {
      allow read: if isOwner(adminUid) || isAdmin();
      allow write: if isOwner(adminUid) || isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isAuthenticated();
      allow update, delete: if false;
    }

    match /rate_limits/{docId} {
      allow read, write: if true;
    }

    match /one_time_resets/{docId} {
      allow read, write: if isAdmin();
    }

    // ============================================================================
    // 📨 SUPPORT MESSAGES COLLECTION
    // ============================================================================
    match /support_messages/{msgId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ============================================================================
    // 🔑 PASSWORD RESETS COLLECTION
    // ============================================================================
    match /password_resets/{resetId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ============================================================================
    // 📱 PHONE DIRECTORY (Fast Lookup & Safe Registration)
    // ============================================================================
    match /phone_directory/{phoneKey} {
      // Public read for existence checking during login and routing
      allow read: if true;

      // Only authenticated users registering their own phone or admins can write/delete
      allow create, update: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ============================================================================
    // 🔔 ADMIN NOTIFICATIONS COLLECTION
    // ============================================================================
    match /admin_notifications/{notifId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ============================================================================
    // ⚙️ APP CONFIG COLLECTION (Protected Credentials)
    // ============================================================================
    match /app_config/{configId} {
      // Only authenticated users or admins can access app configuration
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================================
    // 📋 LAWYER REQUESTS COLLECTION
    // ============================================================================
    match /lawyer_requests/{uid} {
      allow create: if isOwner(uid) || isAdmin();
      allow read, update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }
  }
}
