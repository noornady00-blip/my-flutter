rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@mahameek\\.admin\\.com$')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ==================== USERS COLLECTION ====================
    match /users/{uid} {
      // User can read their own profile, or an authenticated admin can read any profile
      allow read: if isOwner(uid) || isAdmin();

      // Users can create their own document (cannot self-assign admin role)
      allow create: if (isOwner(uid) && (!('role' in request.resource.data) || request.resource.data.role != 'admin')) || isAdmin();

      // Users can update their own data, but CANNOT elevate their role to admin, and CANNOT alter accountId once set
      allow update: if isAdmin() || (
        isOwner(uid) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPrimary'])) &&
        (!('adminResetPassword' in request.resource.data) || request.resource.data.adminResetPassword == resource.data.adminResetPassword) &&
        (!('accountId' in resource.data) || request.resource.data.accountId == resource.data.accountId)
      );

      // Only admins or the owner can delete the account document
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ==================== LAWYERS COLLECTION ====================
    match /lawyers/{uid} {
      // Anyone can read approved lawyers, or owner/admin can read any
      allow read: if (resource.data.status == 'approved') || isOwner(uid) || isAdmin();

      // Lawyer can register with initial status 'pending', or admin can create
      allow create: if (isOwner(uid) && (!('status' in request.resource.data) || request.resource.data.status == 'pending')) || isAdmin();

      // Lawyer can update their profile information, but only admin can approve/reject status, and CANNOT alter accountId once set
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.status == resource.data.status &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'featured'])) &&
        (!('adminResetPassword' in request.resource.data) || request.resource.data.adminResetPassword == resource.data.adminResetPassword) &&
        (!('accountId' in resource.data) || request.resource.data.accountId == resource.data.accountId)
      );

      // Lawyer can delete their own document or admins can delete
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ==================== UNIQUE ACCOUNT IDS REGISTRY ====================
    match /account_ids/{accountId} {
      // Fast public lookup and collision check for 12-digit account numbers
      allow read: if true;
      // Any authenticated user or admin can register their 12-digit account number
      allow create: if isAuthenticated() || isAdmin();
      // Only admins can modify or clean up account ID registry entries
      allow update, delete: if isAdmin();
    }

    // ==================== CHATS & DIRECT MESSAGING ====================
    match /chats/{chatId} {
      // Chat is accessible only to participants or authenticated admins
      allow read: if isAdmin() || (isAuthenticated() && resource.data.participants.hasAny([request.auth.uid]));

      // Initiating a chat requires being one of the participants or an admin
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.participants.hasAny([request.auth.uid]));

      // Updating a chat (lastMessage, unreadCount, etc.) is allowed for participants and admins
      allow update: if isAdmin() || (isAuthenticated() && resource.data.participants.hasAny([request.auth.uid]));

      // Only admins can delete an entire conversation thread
      allow delete: if isAdmin();

      // Subcollection for individual messages
      match /messages/{messageId} {
        // Only chat participants and admins can read messages
        allow read: if isAdmin() || (
          isAuthenticated() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid])
        );

        // Sender must be an authenticated participant in this chat and senderUid must match their auth UID
        allow create: if isAdmin() || (
          isAuthenticated() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) &&
          request.resource.data.senderUid == request.auth.uid
        );

        // Updates (e.g. read status) allowed to chat participants and admins
        allow update: if isAdmin() || (
          isAuthenticated() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid])
        );

        // Message deletion allowed to sender or admin
        allow delete: if isAdmin() || (
          isAuthenticated() &&
          resource.data.senderUid == request.auth.uid
        );
      }
    }

    // ==================== ADMINS COLLECTION ====================
    // STRICT SECURITY: Only existing admins can read/write the admins collection.
    // Self-promotion vulnerability eliminated.
    match /admins/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /admin_tokens/{tokenId} {
      allow read, write: if isAuthenticated() || isAdmin();
    }

    match /admin_fcm_tokens/{adminUid} {
      allow read, write: if isAuthenticated() || isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isAuthenticated();
      allow update, delete: if false;
    }

    match /rate_limits/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /one_time_resets/{docId} {
      allow read, write: if isAdmin();
    }

    // ==================== SUPPORT MESSAGES COLLECTION ====================
    match /support_messages/{msgId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ==================== PASSWORD RESETS COLLECTION ====================
    match /password_resets/{resetId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ==================== PHONE DIRECTORY COLLECTION ====================
    match /phone_directory/{phoneKey} {
      allow read: if true;
      allow create, update: if isAuthenticated() || isAdmin();
      // Owner can delete their own phone_directory entry (verified by uid field), admins can delete any
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // ==================== ADMIN NOTIFICATIONS COLLECTION ====================
    match /admin_notifications/{notifId} {
      allow create: if isAuthenticated() || true;
      allow read, update, delete: if isAdmin();
    }

    // ==================== APP CONFIG COLLECTION ====================
    // FCM credentials must be readable so that clients, lawyers, and password-reset
    // senders can dispatch FCM HTTP v1 administrative push alerts without Cloud Functions
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== LAWYER REQUESTS COLLECTION ====================
    match /lawyer_requests/{uid} {
      allow create: if isOwner(uid) || isAdmin();
      allow read, update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }
  }
}
